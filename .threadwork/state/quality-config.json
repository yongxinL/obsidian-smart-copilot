{
  "_version": "1",
  "typecheck": {
    "enabled": true,
    "blocking": true
  },
  "lint": {
    "enabled": true,
    "blocking": true
  },
  "tests": {
    "enabled": true,
    "blocking": true,
    "minCoverage": 80
  },
  "build": {
    "enabled": false,
    "blocking": false
  },
  "security": {
    "enabled": true,
    "blocking": false
  },
  "outputFilter": {
    "enabled": true,
    "maxFailures": 10,
    "maxErrorsPerGroup": 3,
    "maxLineLength": 200,
    "strategies": {
      "smartFiltering": true,
      "grouping": true,
      "truncation": true,
      "deduplication": true
    }
  }
}